# name: test/sql/geom_3d_analysis.test
# description: GEOM_3D analysis functions (ST_IsPlanar)
# group: [sql]

require three_d

# ST_IsPlanar: a flat polygon is planar
query I
SELECT ST_IsPlanar(ST_Geom3DFromWKB(ST_AsWKBPolygonZ()));
----
true

# ST_IsPlanar: a warped quad is not planar
query I
SELECT ST_IsPlanar(ST_Geom3DFromWKB(ST_AsWKBWarpedPolygonZ()));
----
false

# ST_IsPlanar: a point is trivially planar
query I
SELECT ST_IsPlanar(ST_Geom3DFromWKB(ST_AsWKBPointZ(0.0, 0.0, 0.0)));
----
true

# ST_IsPlanar: NULL propagation
query I
SELECT ST_IsPlanar(NULL::GEOM_3D);
----
NULL

# ST_3DCentroid: point returns itself
query III
SELECT
    ST_3DX(ST_3DCentroid(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0)))),
    ST_3DY(ST_3DCentroid(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0)))),
    ST_3DZ(ST_3DCentroid(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0))));
----
1.0	2.0	3.0

# ST_3DCentroid: square footprint centroid
query III
SELECT
    ST_3DX(ST_3DCentroid(ST_Geom3DFromWKB(ST_AsWKBPolygonZ()))),
    ST_3DY(ST_3DCentroid(ST_Geom3DFromWKB(ST_AsWKBPolygonZ()))),
    ST_3DZ(ST_3DCentroid(ST_Geom3DFromWKB(ST_AsWKBPolygonZ())));
----
2.0	1.5	5.0

# ST_3DCentroid: NULL propagation
query I
SELECT ST_3DCentroid(NULL::GEOM_3D);
----
NULL

# ST_Force3D: identity on an already-3D point
query III
SELECT
    ST_3DX(ST_Force3D(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0)))),
    ST_3DY(ST_Force3D(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0)))),
    ST_3DZ(ST_Force3D(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0))));
----
1.0	2.0	3.0

# ST_Force3D: NULL propagation
query I
SELECT ST_Force3D(NULL::GEOM_3D);
----
NULL

# ST_3DConvexHull: polygon footprint -> same polygon hull at min Z
query IIII
SELECT
    ST_3DGeometryType(ST_3DConvexHull(ST_Geom3DFromWKB(ST_AsWKBPolygonZ()))),
    ST_3DNumGeometries(ST_3DConvexHull(ST_Geom3DFromWKB(ST_AsWKBPolygonZ()))),
    ST_3DZMin(ST_3DConvexHull(ST_Geom3DFromWKB(ST_AsWKBPolygonZ()))),
    ST_3DZMax(ST_3DConvexHull(ST_Geom3DFromWKB(ST_AsWKBPolygonZ())));
----
ST_Polygon	1	5.0	5.0

# ST_3DConvexHull: NULL propagation
query I
SELECT ST_3DConvexHull(NULL::GEOM_3D);
----
NULL

# ST_3DFootprintArea on a GEOM_3D polygon: the XY-footprint area of the 4x3 rectangle = 12.
query I
SELECT ST_3DFootprintArea(ST_Geom3DFromWKB(ST_AsWKBPolygonZ()));
----
12.0

# ST_3DFootprintArea composed with ST_3DConvexHull: the hull of the 4x3 rectangle is the
# rectangle itself, so its footprint area is also 12 (this is the metric the
# PostGIS differential harness uses for ST_3DConvexHull).
query I
SELECT ST_3DFootprintArea(ST_3DConvexHull(ST_Geom3DFromWKB(ST_AsWKBPolygonZ())));
----
12.0

# ST_3DFootprintArea(GEOM_3D): NULL propagation.
query I
SELECT ST_3DFootprintArea(NULL::GEOM_3D);
----
NULL
