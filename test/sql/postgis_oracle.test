# name: test/sql/postgis_oracle.test
# description: differential validation of three_d against frozen PostGIS/SFCGAL golden values (design doc §8.4)
# group: [sql]

# ─────────────────────────────────────────────────────────────────────────────
# This test compares three_d's 3D measurements against reference values computed
# offline by PostGIS + SFCGAL and frozen into
# test/data/postgis_oracle/golden.csv (regenerate with `just oracle-regen`).
#
# It reads the FROZEN ISO WKB from golden.csv and runs each three_d function on
# the SAME bytes SFCGAL saw — so a discrepancy is a real computation bug, not an
# ingestion difference. PostGIS is NOT a test-time dependency: `require three_d`
# only — no cityjson, no container, no network. This is the CI-enforced check.
#
# SFCGAL requires exactly-planar polygon faces and REJECTS most real 3DBAG roofs
# ('rejected' rows carry no reference value); those are cross-checked against
# 3DBAG's own published attributes in cityjson_delft_remote.test instead. The
# tolerance is two-tier: analytic fixtures (small integer coordinates) agree to
# machine precision (tight, 1e-6); the real accepted geometry uses a looser tier
# (1e-3) as conservative headroom for large real-world coordinates, where the two
# engines' summation/triangulation order costs a few more ULPs. See scripts/oracle/.
# ─────────────────────────────────────────────────────────────────────────────

require three_d

statement ok
CREATE TABLE golden AS
SELECT * FROM read_csv('test/data/postgis_oracle/golden.csv', header = true);

# The frozen file is present and non-trivial.
query I
SELECT count(*) >= 10 FROM golden;
----
true

# Every frozen WKB re-imports cleanly through ST_3DFromWKB.
query I
SELECT count(*) = count(ST_3DFromWKB(unhex(wkb_hex)))
FROM golden WHERE geom_role = 'solid';
----
true

# Non-vacuity guard: each tolerance tier below filters on pg_*_status = 'ok', so
# an all-'rejected' golden (e.g. a broken oracle regen) would make those checks
# pass on EMPTY subsets. Assert every tier actually has reference rows to compare.
query I
SELECT count(*) FILTER (WHERE pg_area_status = 'ok'   AND feature_id LIKE 'fixture:%')     >= 2
   AND count(*) FILTER (WHERE pg_volume_status = 'ok' AND feature_id LIKE 'fixture:%')     >= 1
   AND count(*) FILTER (WHERE pg_area_status = 'ok'   AND feature_id NOT LIKE 'fixture:%') >= 1
   AND count(*) FILTER (WHERE pg_volume_status = 'ok' AND feature_id NOT LIKE 'fixture:%') >= 1
FROM golden WHERE geom_role = 'solid';
----
true

# Golden-side anchor: assert the PostGIS reference values themselves against
# analytic truth (unit tetra: area = 3·0.5 + sqrt(3)/2 ≈ 2.366, volume = 1/6).
# This catches a corrupted golden.csv independently of the extension, so the
# tolerance checks below are meaningful on BOTH sides, not just self-consistent.
query II
SELECT ROUND(pg_area3d, 6), ROUND(pg_volume, 6)
FROM golden WHERE feature_id = 'fixture:tetra';
----
2.366025	0.166667

# Closedness agrees exactly (boolean, both engines on the same bytes).
query I
SELECT bool_and(ST_3DIsClosed(ST_3DFromWKB(unhex(wkb_hex))) = pg_is_closed)
FROM golden WHERE geom_role = 'solid';
----
true

# ── Surface area — analytic fixtures, tight tier (rel 1e-6, abs 1e-9) ──
query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DSurfaceArea(ST_3DFromWKB(unhex(wkb_hex))) - pg_area3d)
        <= 1e-6 * abs(pg_area3d) + 1e-9)
FROM golden
WHERE geom_role = 'solid' AND pg_area_status = 'ok'
  AND feature_id LIKE 'fixture:%';
----
true

# ── Surface area — real 3DBAG geometry, loose tier (rel 1e-3, abs 1e-6) ──
query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DSurfaceArea(ST_3DFromWKB(unhex(wkb_hex))) - pg_area3d)
        <= 1e-3 * abs(pg_area3d) + 1e-6)
FROM golden
WHERE geom_role = 'solid' AND pg_area_status = 'ok'
  AND feature_id NOT LIKE 'fixture:%';
----
true

# ── Enclosed volume — analytic fixtures, tight tier ──
query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DVolume(ST_3DFromWKB(unhex(wkb_hex))) - pg_volume)
        <= 1e-6 * abs(pg_volume) + 1e-9)
FROM golden
WHERE geom_role = 'solid' AND pg_volume_status = 'ok'
  AND feature_id LIKE 'fixture:%';
----
true

# ── Enclosed volume — real 3DBAG geometry, loose tier ──
query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DVolume(ST_3DFromWKB(unhex(wkb_hex))) - pg_volume)
        <= 1e-3 * abs(pg_volume) + 1e-6)
FROM golden
WHERE geom_role = 'solid' AND pg_volume_status = 'ok'
  AND feature_id NOT LIKE 'fixture:%';
----
true

# ── Convex-hull area (2D-XY). The extension measures its own hull with
# ST_3DFootprintArea(ST_3DConvexHull(g)); PostGIS uses ST_Area(ST_ConvexHull(ST_Points(g)))
# because GEOS's ST_ConvexHull rejects a PolyhedralSurface. GEOS has no planarity
# requirement, so this covers all geometry (no 'rejected' rows) — including the
# degenerate hulls of the point/line fixtures, whose XY hull has zero area.
# ST_Geom3DFromWKB rejects GeometryCollection by design, so that row is excluded. ──
# Non-vacuity: every solid has a positive hull area to compare against.
query I
SELECT bool_and(pg_hull_area > 0) FROM golden WHERE geom_role = 'solid';
----
true

query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DFootprintArea(ST_3DConvexHull(ST_Geom3DFromWKB(unhex(wkb_hex)))) - pg_hull_area)
        <= 1e-6 * abs(pg_hull_area) + 1e-6)
FROM golden WHERE pg_geomtype <> 'ST_GeometryCollection';
----
true

# Pin: the unit tetra's XY hull is the triangle (0,0),(1,0),(0,1) → area 0.5.
query I
SELECT ROUND(ST_3DFootprintArea(ST_3DConvexHull(ST_Geom3DFromWKB(unhex(wkb_hex)))), 4)
FROM golden WHERE feature_id = 'fixture:tetra';
----
0.5

# ── Deterministic per-feature pins (high-signal regression anchors) ──
# Unit tetrahedron: surface area 2.366…, volume 1/6.
query II
SELECT ROUND(ST_3DSurfaceArea(ST_3DFromWKB(unhex(wkb_hex))), 6),
       ROUND(ST_3DVolume(ST_3DFromWKB(unhex(wkb_hex))), 6)
FROM golden WHERE feature_id = 'fixture:tetra';
----
2.366025	0.166667

# Real flat-roof 3DBAG box that SFCGAL accepts (the only non-fixture 'ok' row).
query II
SELECT ROUND(ST_3DSurfaceArea(ST_3DFromWKB(unhex(wkb_hex))), 2),
       ROUND(ST_3DVolume(ST_3DFromWKB(unhex(wkb_hex))), 1)
FROM golden WHERE feature_id = 'NL.IMBAG.Pand.0703100000035935-0';
----
420.82	375.1

# ── Invalid geometry: the extension is the oracle of record ──
# The open shell (tetra missing a face) is 'rejected' by SFCGAL for volume; the
# extension likewise refuses ST_3DVolume with the documented precondition error
# (it flags, it does not repair — design doc §8.1).
query I
SELECT pg_volume_status FROM golden WHERE feature_id = 'fixture:open_tetra';
----
rejected

statement error
SELECT ST_3DVolume(ST_3DFromWKB(unhex(wkb_hex)))
FROM golden WHERE feature_id = 'fixture:open_tetra';
----
not closed

# ─────────────────────────────────────────────────────────────────────────────
# Distance + relation predicates between geometry PAIRS. Unlike volume/area,
# SFCGAL's 3D distance/relation functions compute on the non-planar 3DBAG
# surfaces without rejection, so these cover real geometry too. Each pair's
# frozen WKB is resolved from the solids golden above by joining on feature id.
# ─────────────────────────────────────────────────────────────────────────────
statement ok
CREATE TABLE golden_pairs AS
SELECT * FROM read_csv('test/data/postgis_oracle/golden_pairs.csv', header = true);

# Non-vacuity: each boolean predicate is exercised with BOTH outcomes, so the
# bool_and(... = ...) checks below can't pass trivially on a constant column.
query I
SELECT count(DISTINCT pg_intersects) = 2
   AND count(DISTINCT pg_dwithin) = 2
   AND count(DISTINCT pg_dfullywithin) = 2
FROM golden_pairs;
----
true

# The WKB-resolving join is TOTAL: every pair endpoint exists in golden, so no
# pair is silently dropped (which would let the checks below pass on a subset).
query I
SELECT (SELECT count(*) FROM golden_pairs) = count(*)
FROM golden_pairs p
JOIN golden a ON a.feature_id = p.feature_a
JOIN golden b ON b.feature_id = p.feature_b;
----
true

# 3D minimum distance agrees (SFCGAL computes on the raw non-planar surfaces).
query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DDistance(ST_Geom3DFromWKB(unhex(a.wkb_hex)),
                          ST_Geom3DFromWKB(unhex(b.wkb_hex))) - p.pg_dist3d)
        <= 1e-6 * abs(p.pg_dist3d) + 1e-6)
FROM golden_pairs p
JOIN golden a ON a.feature_id = p.feature_a
JOIN golden b ON b.feature_id = p.feature_b;
----
true

# 3D maximum distance agrees.
query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DMaxDistance(ST_Geom3DFromWKB(unhex(a.wkb_hex)),
                             ST_Geom3DFromWKB(unhex(b.wkb_hex))) - p.pg_maxdist3d)
        <= 1e-6 * abs(p.pg_maxdist3d) + 1e-6)
FROM golden_pairs p
JOIN golden a ON a.feature_id = p.feature_a
JOIN golden b ON b.feature_id = p.feature_b;
----
true

# Shortest-line length: the extension's ST_3DShortestLine, measured by
# ST_3DLength, matches PostGIS's — scalars only, never a geometry round-trip
# (PostGIS emits EWKB the ISO parser rejects). Equals the distance by construction.
query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DLength(ST_3DShortestLine(ST_Geom3DFromWKB(unhex(a.wkb_hex)),
                                          ST_Geom3DFromWKB(unhex(b.wkb_hex))))
            - p.pg_shortline_len)
        <= 1e-6 * abs(p.pg_shortline_len) + 1e-6)
FROM golden_pairs p
JOIN golden a ON a.feature_id = p.feature_a
JOIN golden b ON b.feature_id = p.feature_b;
----
true

# Closest point: the distance from ST_3DClosestPoint(a, b) back to b matches
# PostGIS's (closest-point ties may sit at different coordinates between engines,
# but this scalar is tie-invariant).
query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DDistance(ST_3DClosestPoint(ST_Geom3DFromWKB(unhex(a.wkb_hex)),
                                            ST_Geom3DFromWKB(unhex(b.wkb_hex))),
                          ST_Geom3DFromWKB(unhex(b.wkb_hex)))
            - p.pg_closestpoint_dist)
        <= 1e-6 * abs(p.pg_closestpoint_dist) + 1e-6)
FROM golden_pairs p
JOIN golden a ON a.feature_id = p.feature_a
JOIN golden b ON b.feature_id = p.feature_b;
----
true

# Relation predicates (intersects / dwithin / dfullywithin) agree EXACTLY.
# IS NOT DISTINCT FROM (not =) so a predicate that unexpectedly returns NULL
# fails the check rather than being silently skipped by bool_and.
query I
SELECT bool_and(ST_3DIntersects(ST_Geom3DFromWKB(unhex(a.wkb_hex)),
                                ST_Geom3DFromWKB(unhex(b.wkb_hex))) IS NOT DISTINCT FROM p.pg_intersects)
   AND bool_and(ST_3DDWithin(ST_Geom3DFromWKB(unhex(a.wkb_hex)),
                             ST_Geom3DFromWKB(unhex(b.wkb_hex)), p.threshold) IS NOT DISTINCT FROM p.pg_dwithin)
   AND bool_and(ST_3DDFullyWithin(ST_Geom3DFromWKB(unhex(a.wkb_hex)),
                                  ST_Geom3DFromWKB(unhex(b.wkb_hex)), p.threshold) IS NOT DISTINCT FROM p.pg_dfullywithin)
FROM golden_pairs p
JOIN golden a ON a.feature_id = p.feature_a
JOIN golden b ON b.feature_id = p.feature_b;
----
true

# Deterministic pin: the two distinct buildings are ~517.6 m apart (min),
# ~563.8 m (max), and do not intersect.
query III
SELECT ROUND(ST_3DDistance(ST_Geom3DFromWKB(unhex(a.wkb_hex)),
                           ST_Geom3DFromWKB(unhex(b.wkb_hex))), 2),
       ROUND(ST_3DMaxDistance(ST_Geom3DFromWKB(unhex(a.wkb_hex)),
                              ST_Geom3DFromWKB(unhex(b.wkb_hex))), 2),
       ST_3DIntersects(ST_Geom3DFromWKB(unhex(a.wkb_hex)),
                       ST_Geom3DFromWKB(unhex(b.wkb_hex)))
FROM golden a, golden b
WHERE a.feature_id = 'NL.IMBAG.Pand.0703100000035935-0'
  AND b.feature_id = 'NL.IMBAG.Pand.0703100000028278-0';
----
517.64	563.84	false

statement ok
DROP TABLE golden_pairs;

# ─────────────────────────────────────────────────────────────────────────────
# Accessors, serialization, and footprint on every frozen geometry.
#
# The golden carries two input roles. 'solid' rows import through ST_3DFromWKB
# into SOLID_3D; 'geom' rows are the point/line/polygon/multi-* fixtures that a
# SOLID_3D cannot hold and import through ST_Geom3DFromWKB into GEOM_3D. Some
# accessors exist on only one of the two, hence the role filters below.
#
# Where PostGIS is deliberately NOT the reference:
#   * ST_3DDimension / ST_3DNumGeometries on a PolyhedralSurface — PostGIS reads
#     a closed PolyhedralSurface as a solid (ST_Dimension = 3, and 2 for the open
#     one) and ST_NumGeometries as its patch count; three_d reports the
#     topological dimension of the surface (2) and treats the surface as one
#     geometry. Different questions, so those two are oracled on the 'geom' rows.
#   * ST_3DPerimeter — PostGIS's is the sum of every face's ring length; three_d's
#     is the length of the *boundary* edges only (0 for a closed solid). Not the
#     same measurement; see docs/TEST_COVERAGE.md.
# ─────────────────────────────────────────────────────────────────────────────

# Non-vacuity: the GEOM_3D tier exists and every one of its classes is present.
query I
SELECT count(*) >= 7 AND count(DISTINCT pg_geomtype) >= 6
FROM golden WHERE geom_role = 'geom';
----
true

# Every frozen 'geom' WKB re-imports cleanly through ST_Geom3DFromWKB.
query I
SELECT count(*) = count(ST_Geom3DFromWKB(unhex(wkb_hex)))
FROM golden WHERE geom_role = 'geom';
----
true

# ── Geometry class. ST_Geom3DFromWKB rejects GeometryCollection by design
# (multi-solid collections belong to ST_3DFromWKB), so that one row is excluded. ──
query I
SELECT bool_and(ST_3DGeometryType(ST_Geom3DFromWKB(unhex(wkb_hex))) = pg_geomtype)
FROM golden WHERE pg_geomtype <> 'ST_GeometryCollection';
----
true

# ── Coordinate dimensionality: ST_NDims on both types, ST_CoordDim on GEOM_3D. ──
query I
SELECT bool_and(ST_NDims(ST_3DFromWKB(unhex(wkb_hex))) = pg_ndims)
FROM golden WHERE geom_role = 'solid';
----
true

query I
SELECT bool_and(ST_NDims(ST_Geom3DFromWKB(unhex(wkb_hex))) = pg_ndims)
   AND bool_and(ST_CoordDim(ST_Geom3DFromWKB(unhex(wkb_hex))) = pg_coorddim)
FROM golden WHERE geom_role = 'geom';
----
true

# ── Topological dimension and member count, on the classes where the two
# definitions coincide (see the note above). Non-vacuity: both columns vary. ──
query I
SELECT count(DISTINCT pg_dimension) >= 3 AND count(DISTINCT pg_numgeom) >= 3
FROM golden WHERE geom_role = 'geom';
----
true

query I
SELECT bool_and(ST_3DDimension(ST_Geom3DFromWKB(unhex(wkb_hex))) = pg_dimension)
   AND bool_and(ST_3DNumGeometries(ST_Geom3DFromWKB(unhex(wkb_hex))) = pg_numgeom)
FROM golden WHERE geom_role = 'geom';
----
true

# ── ST_3DLength. Zero for every class but (multi)linestring, which is exactly
# what makes the two non-zero fixture rows worth pinning. ──
query I
SELECT count(*) FILTER (WHERE pg_length3d > 0) = 2 FROM golden;
----
true

query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DLength(ST_Geom3DFromWKB(unhex(wkb_hex))) - pg_length3d)
        <= 1e-9 * abs(pg_length3d) + 1e-9)
FROM golden WHERE pg_geomtype <> 'ST_GeometryCollection';
----
true

# ── Z extent — exact on every row, including the SFCGAL-rejected roofs. ──
query I
SELECT bool_and(ST_3DZMin(ST_3DFromWKB(unhex(wkb_hex))) = pg_min_z)
   AND bool_and(ST_3DZMax(ST_3DFromWKB(unhex(wkb_hex))) = pg_max_z)
FROM golden WHERE geom_role = 'solid';
----
true

query I
SELECT bool_and(ST_3DZMin(ST_Geom3DFromWKB(unhex(wkb_hex))) = pg_min_z)
   AND bool_and(ST_3DZMax(ST_Geom3DFromWKB(unhex(wkb_hex))) = pg_max_z)
FROM golden WHERE geom_role = 'geom';
----
true

# ── The full 3D bounding box. ST_3DBounds takes SOLID_3D only, so the 'geom'
# rows are covered by the ST_3DZMin/ZMax pair above. Both engines read the same
# doubles off the same vertices, so this is an exact comparison. ──
query I
SELECT bool_and(b.min_x = pg_min_x) AND bool_and(b.min_y = pg_min_y)
   AND bool_and(b.min_z = pg_min_z) AND bool_and(b.max_x = pg_max_x)
   AND bool_and(b.max_y = pg_max_y) AND bool_and(b.max_z = pg_max_z)
FROM golden, LATERAL (SELECT ST_3DBounds(ST_3DFromWKB(unhex(wkb_hex))) AS b)
WHERE geom_role = 'solid';
----
true

# ── Footprint area. PostGIS sums the |XY projection| of every patch. A two-sided
# shell is crossed twice by each vertical column, so three_d's footprint is half
# of that; a (multi)polygon is single-sided and the two agree directly. ──
query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DFootprintArea(ST_3DFromWKB(unhex(wkb_hex))) - pg_proj_area / 2)
        <= 1e-9 * abs(pg_proj_area) + 1e-9)
FROM golden WHERE geom_role = 'solid';
----
true

query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DFootprintArea(ST_Geom3DFromWKB(unhex(wkb_hex))) - pg_proj_area)
        <= 1e-9 * abs(pg_proj_area) + 1e-9)
FROM golden WHERE geom_role = 'geom';
----
true

# ── Planarity. SFCGAL's ST_IsPlanar is defined for polygons only; the other
# classes record 'rejected'. Non-vacuity: one planar and one warped fixture. ──
query I
SELECT count(*) FILTER (WHERE pg_is_planar) = 1
   AND count(*) FILTER (WHERE NOT pg_is_planar) = 1
FROM golden WHERE pg_is_planar_status = 'ok';
----
true

query I
SELECT bool_and(ST_IsPlanar(ST_Geom3DFromWKB(unhex(wkb_hex))) IS NOT DISTINCT FROM pg_is_planar)
FROM golden WHERE pg_is_planar_status = 'ok';
----
true

# ── Point ordinates. ST_X/Y/Z and ST_3DX/Y/Z both raise on non-points, so the
# comparison is over the single Point fixture. ──
query I
SELECT count(*) = 1 FROM golden WHERE pg_xyz_status = 'ok';
----
true

query I
SELECT bool_and(ST_3DX(g) = pg_x AND ST_3DY(g) = pg_y AND ST_3DZ(g) = pg_z)
FROM golden, LATERAL (SELECT ST_Geom3DFromWKB(unhex(wkb_hex)) AS g)
WHERE pg_xyz_status = 'ok';
----
true

# ── WKB serialization. PostGIS re-emits every frozen input byte-for-byte
# (pg_wkb_roundtrip), so asserting three_d's exports against wkb_hex is genuine
# agreement between two ISO-WKB writers, not a self-comparison. ──
query I
SELECT bool_and(pg_wkb_roundtrip) FROM golden;
----
true

query I
SELECT bool_and(hex(ST_3DAsWKB(ST_3DFromWKB(unhex(wkb_hex)))) = upper(wkb_hex))
FROM golden WHERE geom_role = 'solid';
----
true

query I
SELECT bool_and(hex(ST_3DAsBinary(ST_Geom3DFromWKB(unhex(wkb_hex)))) = upper(wkb_hex))
FROM golden WHERE pg_geomtype <> 'ST_GeometryCollection';
----
true

# ── WKT. Compared numerically, not as strings: three_d formats ordinates with
# "%.9g" (kernel/geom_serialize.cpp) while PostGIS emits round-trip precision,
# and PostGIS writes no space after the comma. Pulling the numbers out of both
# and comparing them pairwise checks the geometry rather than the layout — the
# token counts must match too, which is what catches a dropped ring or vertex. ──
statement ok
CREATE TABLE wkt_tokens AS
SELECT feature_id,
       regexp_extract_all(ST_3DAsText(ST_Geom3DFromWKB(unhex(wkb_hex))),
                          '-?[0-9]+\.?[0-9]*([eE][-+]?[0-9]+)?') AS mine,
       regexp_extract_all(pg_wkt, '-?[0-9]+\.?[0-9]*([eE][-+]?[0-9]+)?') AS theirs
FROM golden WHERE pg_geomtype <> 'ST_GeometryCollection';

query I
SELECT bool_and(len(mine) = len(theirs))
   AND bool_and(len(mine) >= 3)     -- the Point fixture is the 3-ordinate floor
   AND max(len(mine)) >= 100        -- and a real roof carries hundreds
FROM wkt_tokens;
----
true

query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(a::DOUBLE - b::DOUBLE) <= 1e-8 * abs(b::DOUBLE) + 1e-9)
FROM (SELECT unnest(mine) AS a, unnest(theirs) AS b FROM wkt_tokens);
----
true

statement ok
DROP TABLE wkt_tokens;

# ── GeoJSON. PostGIS has no GeoJSON encoding for PolyhedralSurface and raises;
# three_d emits a MultiPolygon there instead (documented divergence, so those
# rows carry status 'rejected' and no reference value). On the classes PostGIS
# does encode, the two agree as exact strings. ──
query I
SELECT count(*) = 7 FROM golden WHERE pg_geojson_status = 'ok';
----
true

query I
SELECT bool_and(ST_3DAsGeoJSON(ST_Geom3DFromWKB(unhex(wkb_hex))) = pg_geojson)
FROM golden WHERE pg_geojson_status = 'ok';
----
true

# ─────────────────────────────────────────────────────────────────────────────
# Affine and CRS transforms.
#
# golden_transforms.csv holds, per (geometry, op), the 3D bounding box PostGIS
# computes after applying the op — plus a re-measurement of area/volume/length,
# which is where the invariants live: a rigid motion must not change volume, and
# the anisotropic scale must multiply it by det = 2·3·0.5 = 3. PostGIS's
# ST_RotateX/Y/Z are right-handed and counter-clockwise in radians, and its
# ST_Transform passes Z through — the conventions three_d documents.
#
# This is the oracle-backed guard for the volume bug fixed in b019978, where
# referencing the volume tetrahedra to the origin made ST_3DVolume
# rotation-dependent on real-world coordinates.
# ─────────────────────────────────────────────────────────────────────────────
statement ok
CREATE TABLE golden_transforms AS
SELECT * FROM read_csv('test/data/postgis_oracle/golden_transforms.csv', header = true);

# Every op is present on every geometry (the reprojection excepted — it is
# emitted for the real 3DBAG rows only, see scripts/oracle/).
query I
SELECT count(DISTINCT op) = 6
   AND count(*) FILTER (WHERE op = 'transform_28992_4326') = 9
   AND count(*) FILTER (WHERE op <> 'transform_28992_4326')
       = 5 * (SELECT count(*) FROM golden)
FROM golden_transforms;
----
true

# Apply each op with three_d's own function, on the same frozen bytes.
statement ok
CREATE TABLE t_solid AS
SELECT p.*,
       CASE p.op
         WHEN 'translate' THEN ST_3DTranslate(s.g, 100.5, -50.25, 5.125)
         WHEN 'scale'     THEN ST_3DScale(s.g, 2.0, 3.0, 0.5)
         WHEN 'rotatex'   THEN ST_3DRotateX(s.g, 0.7)
         WHEN 'rotatey'   THEN ST_3DRotateY(s.g, 0.7)
         WHEN 'rotatez'   THEN ST_3DRotateZ(s.g, 0.7)
         ELSE                  ST_3DTransform(s.g, 28992, 4326)
       END AS g
FROM golden_transforms p
JOIN (SELECT feature_id, ST_3DFromWKB(unhex(wkb_hex)) AS g
      FROM golden WHERE geom_role = 'solid') s USING (feature_id)
WHERE p.geom_role = 'solid';

statement ok
CREATE TABLE t_geom AS
SELECT p.*,
       CASE p.op
         WHEN 'translate' THEN ST_3DTranslate(s.g, 100.5, -50.25, 5.125)
         WHEN 'scale'     THEN ST_3DScale(s.g, 2.0, 3.0, 0.5)
         WHEN 'rotatex'   THEN ST_3DRotateX(s.g, 0.7)
         WHEN 'rotatey'   THEN ST_3DRotateY(s.g, 0.7)
         ELSE                  ST_3DRotateZ(s.g, 0.7)
       END AS g
FROM golden_transforms p
JOIN (SELECT feature_id, ST_Geom3DFromWKB(unhex(wkb_hex)) AS g
      FROM golden WHERE geom_role = 'geom') s USING (feature_id)
WHERE p.geom_role = 'geom';

# The join is total on both sides — no op row is silently dropped.
query I
SELECT (SELECT count(*) FROM t_solid) + (SELECT count(*) FROM t_geom)
     = (SELECT count(*) FROM golden_transforms);
----
true

# ── Transformed bounding box. The affine ops are exact double arithmetic on
# both sides; the reprojection gets a looser absolute tier because the two PROJ
# builds differ (7.2.1 in the oracle container) and pick their own pipeline for
# EPSG:28992 → EPSG:4326 without the NL grid. Measured divergence there is under
# 1e-9 degrees; 1e-7 (≈1 cm) is the headroom. ──
query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(b.min_x - pg_min_x) <= tol AND abs(b.min_y - pg_min_y) <= tol
    AND abs(b.min_z - pg_min_z) <= tol AND abs(b.max_x - pg_max_x) <= tol
    AND abs(b.max_y - pg_max_y) <= tol AND abs(b.max_z - pg_max_z) <= tol)
FROM t_solid, LATERAL (SELECT ST_3DBounds(g) AS b),
     LATERAL (SELECT CASE WHEN op = 'transform_28992_4326' THEN 1e-7
                          ELSE 1e-9 * greatest(abs(pg_max_x), abs(pg_max_y), 1.0) END AS tol);
----
true

# ST_3DBounds is SOLID_3D-only, so the GEOM_3D rows compare the Z extent.
query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DZMin(g) - pg_min_z) <= 1e-9 * abs(pg_min_z) + 1e-9
    AND abs(ST_3DZMax(g) - pg_max_z) <= 1e-9 * abs(pg_max_z) + 1e-9)
FROM t_geom;
----
true

# ── Volume and surface area after each AFFINE op. The reprojection is excluded
# from these two: its output is in degrees, where an "area" or "volume" is not a
# quantity either engine is really computing, and the ~1e-9° pipeline difference
# between the two PROJ builds amplifies into a 1e-3 relative gap on the smallest
# faces. The bounding-box check above is what oracles ST_3DTransform. ──
# Non-vacuity first: SFCGAL must have accepted real 3DBAG rows as well as the
# fixtures under the affine ops, or the loose tier would be empty.
query I
SELECT count(*) FILTER (WHERE pg_volume_status = 'ok' AND feature_id LIKE 'fixture:%')     >= 4
   AND count(*) FILTER (WHERE pg_volume_status = 'ok' AND feature_id NOT LIKE 'fixture:%') >= 4
FROM t_solid WHERE op <> 'transform_28992_4326';
----
true

query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DVolume(g) - pg_volume) <= 1e-6 * abs(pg_volume) + 1e-9)
FROM t_solid WHERE pg_volume_status = 'ok' AND op <> 'transform_28992_4326'
  AND feature_id LIKE 'fixture:%';
----
true

query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DVolume(g) - pg_volume) <= 1e-3 * abs(pg_volume) + 1e-6)
FROM t_solid WHERE pg_volume_status = 'ok' AND op <> 'transform_28992_4326'
  AND feature_id NOT LIKE 'fixture:%';
----
true

query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DSurfaceArea(g) - pg_area3d) <= 1e-6 * abs(pg_area3d) + 1e-9)
FROM t_solid WHERE pg_area_status = 'ok' AND op <> 'transform_28992_4326'
  AND feature_id LIKE 'fixture:%';
----
true

query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DSurfaceArea(g) - pg_area3d) <= 1e-3 * abs(pg_area3d) + 1e-6)
FROM t_solid WHERE pg_area_status = 'ok' AND op <> 'transform_28992_4326'
  AND feature_id NOT LIKE 'fixture:%';
----
true

# ── Length and footprint after each op, on the GEOM_3D rows. Both are
# planarity-free, so they cover the classes area/volume cannot reach. ──
query I
SELECT count(*) = count(*) FILTER (
  WHERE abs(ST_3DLength(g) - pg_length3d) <= 1e-9 * abs(pg_length3d) + 1e-9
    AND abs(ST_3DFootprintArea(g) - pg_proj_area) <= 1e-9 * abs(pg_proj_area) + 1e-9)
FROM t_geom;
----
true

# ── Deterministic pins on the analytic fixtures: rotations preserve the unit
# tetra's volume, the anisotropic scale triples it (det = 2·3·0.5). ──
query IIII
SELECT ROUND(max(ST_3DVolume(g)) FILTER (WHERE op = 'rotatex'), 9),
       ROUND(max(ST_3DVolume(g)) FILTER (WHERE op = 'rotatey'), 9),
       ROUND(max(ST_3DVolume(g)) FILTER (WHERE op = 'translate'), 9),
       ROUND(max(ST_3DVolume(g)) FILTER (WHERE op = 'scale'), 9)
FROM t_solid WHERE feature_id = 'fixture:tetra';
----
0.166666667	0.166666667	0.166666667	0.5

statement ok
DROP TABLE t_geom;

statement ok
DROP TABLE t_solid;

statement ok
DROP TABLE golden_transforms;

statement ok
DROP TABLE golden;
