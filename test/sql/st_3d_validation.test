# name: test/sql/st_3d_validation.test
# description: test ST_3D validation functions
# group: [sql]

require three_d

require-env THREE_D_TEST_FIXTURES

# Create a tetrahedron solid (should be valid)
statement ok
CREATE TABLE solids AS
SELECT ST_3DFromWKB(ST_AsWKBPolyhedralTetra()) AS solid;

# Test: ST_3DIsClosed
query I
SELECT ST_3DIsClosed(solid) FROM solids;
----
true

# Test: ST_3DIsManifold
query I
SELECT ST_3DIsManifold(solid) FROM solids;
----
true

# Test: ST_3DIsOriented
query I
SELECT ST_3DIsOriented(solid) FROM solids;
----
true

# Test: ST_3DValidationReport returns struct with all fields
query IIIIIIIIIIIII
SELECT
    r.is_valid,
    r.is_closed,
    r.is_manifold,
    r.is_oriented,
    r.solid_count,
    r.shell_count,
    r.face_count,
    r.open_edge_count,
    r.non_manifold_edge_count,
    r.degenerate_face_count,
    r.orientation_error_count,
    r.code,
    r.message
FROM (SELECT ST_3DValidationReport(solid) AS r FROM solids);
----
true	true	true	true	1	1	4	0	0	0	0	VALID	Valid solid

# Test: NULL propagation. Each validation function is overloaded over SOLID_3D /
# BLOB, so an untyped NULL is ambiguous and must be cast.
query IIII
SELECT ST_3DIsClosed(NULL::SOLID_3D), ST_3DIsManifold(NULL::SOLID_3D), ST_3DIsOriented(NULL::SOLID_3D),
       ST_3DValidationReport(NULL::SOLID_3D) IS NULL;
----
NULL	NULL	NULL	true

statement ok
DROP TABLE solids;

# ──────────────────────────────────────────────────────────────
# Invalid solid: an open shell (tetrahedron missing one face) imports
# successfully but is reported invalid — the extension is the oracle of
# record for invalid geometry (it flags, it does not repair; design doc §8.1).
# ──────────────────────────────────────────────────────────────
statement ok
CREATE TABLE open_solids AS
SELECT ST_3DFromWKB(ST_AsWKBOpenTetra()) AS solid;

# The report flags the open shell: not valid, not closed, with unpaired edges,
# yet still manifold and correctly oriented on the faces that are present.
query IIIIIIIIIIIII
SELECT
    r.is_valid,
    r.is_closed,
    r.is_manifold,
    r.is_oriented,
    r.solid_count,
    r.shell_count,
    r.face_count,
    r.open_edge_count,
    r.non_manifold_edge_count,
    r.degenerate_face_count,
    r.orientation_error_count,
    r.code,
    r.message
FROM (SELECT ST_3DValidationReport(solid) AS r FROM open_solids);
----
false	false	true	true	1	1	3	3	0	0	0	INVALID	Invalid solid: not closed

statement ok
DROP TABLE open_solids;

# ──────────────────────────────────────────────────────────────
# Degeneracy is a property of the shape, not of where the shape sits.
#
# IsFaceDegenerate compares a Newell area magnitude against an absolute epsilon
# (kEpsAbsolute, 1e-12). Computed on absolute coordinates that magnitude carries
# n·eps·|position|·|extent| of rounding noise — 1e-11 to 1e-10 at RD New
# (EPSG:28992) easting/northing — so a face with exactly zero area could pass the
# test that correctly rejects it near the origin. degenerate_face_count gates
# ST_3DVolume and ST_3DSurfaceArea, so that made a hard error position-dependent.
# Newell is now referenced to the ring's own first vertex; the red case lives at
# kernel level in test/cpp/test_geometry_math.cpp and test/cpp/test_validation.cpp,
# and this pins the SQL-visible contract: same verdict at every offset.
# ──────────────────────────────────────────────────────────────
statement ok
CREATE TABLE flat_solids AS
SELECT unnest([0.0, 100.0, 85000.0, 447000.0, 1000000.0, 1e8]) AS d,
       ST_3DFromWKB(ST_AsWKBPolyhedralTetra()) AS solid;

query II
SELECT count(*), count(*) FILTER (
    WHERE NOT (ST_3DValidationReport(
        ST_3DTranslate(ST_3DScale(solid, 0.0, 1.0, 1.0), d, d * 5, 0))).is_valid
      AND (ST_3DValidationReport(
        ST_3DTranslate(ST_3DScale(solid, 0.0, 1.0, 1.0), d, d * 5, 0))).degenerate_face_count = 2)
FROM flat_solids;
----
6	6

statement ok
DROP TABLE flat_solids;
