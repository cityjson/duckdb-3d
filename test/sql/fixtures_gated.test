# name: test/sql/fixtures_gated.test
# description: st_aswkb* fixture generators are registered only when THREE_D_TEST_FIXTURES is set
# group: [sql]

require three_d

require-env THREE_D_TEST_FIXTURES

# The `<> 'st_aswkb'` exclusion drops DuckDB's own core geometry ST_AsWKB, which
# is unrelated to this extension; what remains is exactly our 11 fixtures.
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name LIKE 'st_aswkb%' AND function_name <> 'st_aswkb';
----
11

# The production surface is registered unconditionally — the gate covers fixtures only.
query I
SELECT count(*) > 0 FROM duckdb_functions() WHERE function_name = 'st_3dfromwkb';
----
true
