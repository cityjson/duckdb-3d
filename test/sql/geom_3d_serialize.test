# name: test/sql/geom_3d_serialize.test
# description: GEOM_3D serialization functions (ST_3DAsText / ST_3DAsGeoJSON / ST_3DAsBinary)
# group: [sql]

require three_d

# ST_3DAsText: Point Z
query I
SELECT ST_3DAsText(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0)));
----
POINT Z (1 2 3)

# ST_3DAsText: Polygon Z
query I
SELECT ST_3DAsText(ST_Geom3DFromWKB(ST_AsWKBPolygonZ()));
----
POLYGON Z ((0 0 5, 4 0 5, 4 3 5, 0 3 5, 0 0 5))

# ST_3DAsGeoJSON: Point
query I
SELECT ST_3DAsGeoJSON(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0)));
----
{"type":"Point","coordinates":[1,2,3]}

# ST_3DAsBinary: round-trip Point Z through ST_Geom3DFromWKB
query III
SELECT
    ST_3DX(ST_Geom3DFromWKB(ST_3DAsBinary(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0))))),
    ST_3DY(ST_Geom3DFromWKB(ST_3DAsBinary(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0))))),
    ST_3DZ(ST_Geom3DFromWKB(ST_3DAsBinary(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0)))));
----
1.0	2.0	3.0

# ST_3DAsText: NULL propagation
query I
SELECT ST_3DAsText(NULL::GEOM_3D);
----
NULL
