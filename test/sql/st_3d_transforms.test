# name: test/sql/st_3d_transforms.test
# description: test ST_3D transform functions (Translate)
# group: [sql]

require three_d

statement ok
CREATE TABLE solids AS
SELECT ST_3DFromWKB(ST_AsWKBPolyhedralTetra()) AS solid;

# ST_Translate shifts the bounding box by the given offsets
query IIIIII
SELECT b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z
FROM (SELECT ST_3DBounds(ST_Translate(solid, 10.0, 20.0, 30.0)) AS b FROM solids);
----
10.0	20.0	30.0	11.0	21.0	31.0

# ST_Translate preserves volume (rigid motion)
query I
SELECT ST_3DVolume(ST_Translate(solid, 10.0, 20.0, 30.0)) = ST_3DVolume(solid) FROM solids;
----
true

# ST_Translate preserves validity (rigid motion)
query I
SELECT ST_3DIsClosed(ST_Translate(solid, 5.0, -5.0, 1.5)) FROM solids;
----
true

# Translate then inverse-translate round-trips the bounds
query IIIIII
SELECT b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z
FROM (SELECT ST_3DBounds(ST_Translate(ST_Translate(solid, 7.0, 8.0, 9.0), -7.0, -8.0, -9.0)) AS b FROM solids);
----
0.0	0.0	0.0	1.0	1.0	1.0

# NULL propagates
query I
SELECT ST_Translate(NULL::SOLID_3D, 1.0, 2.0, 3.0) IS NULL;
----
true

# ST_Scale scales the bounding box about the origin
query IIIIII
SELECT b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z
FROM (SELECT ST_3DBounds(ST_Scale(solid, 2.0, 3.0, 4.0)) AS b FROM solids);
----
0.0	0.0	0.0	2.0	3.0	4.0

# ST_Scale multiplies volume by sx*sy*sz (here 2*3*4 = 24 → 1/6 * 24 = 4)
query I
SELECT ROUND(ST_3DVolume(ST_Scale(solid, 2.0, 3.0, 4.0)), 5) FROM solids;
----
4.0

# ST_Scale preserves validity for non-degenerate factors
query I
SELECT ST_3DIsClosed(ST_Scale(solid, 2.0, 2.0, 2.0)) FROM solids;
----
true

# NULL propagates
query I
SELECT ST_Scale(NULL, 1.0, 2.0, 3.0) IS NULL;
----
true

# ST_RotateX / ST_RotateY / ST_RotateZ are rigid rotations: volume is preserved
query III
SELECT ROUND(ST_3DVolume(ST_RotateX(solid, radians(90))), 5),
       ROUND(ST_3DVolume(ST_RotateY(solid, radians(37))), 5),
       ROUND(ST_3DVolume(ST_RotateZ(solid, radians(90))), 5)
FROM solids;
----
0.16667	0.16667	0.16667

# ST_RotateZ by 90 deg maps (x,y) -> (-y,x): X extent becomes [-1, 0]
query II
SELECT ROUND(b.min_x, 5), ROUND(b.max_x, 5)
FROM (SELECT ST_3DBounds(ST_RotateZ(solid, radians(90))) AS b FROM solids);
----
-1.0	0.0

# Rotations preserve validity
query I
SELECT ST_3DIsClosed(ST_RotateX(solid, radians(45))) FROM solids;
----
true

# NULL propagates for each axis
query III
SELECT ST_RotateX(NULL, 1.0) IS NULL, ST_RotateY(NULL, 1.0) IS NULL, ST_RotateZ(NULL, 1.0) IS NULL;
----
true	true	true

statement ok
DROP TABLE solids;
