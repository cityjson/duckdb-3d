# name: test/sql/st_3d_transforms.test
# description: test ST_3D transform functions (Translate)
# group: [sql]

require three_d

require-env THREE_D_TEST_FIXTURES

statement ok
CREATE TABLE solids AS
SELECT ST_3DFromWKB(ST_AsWKBPolyhedralTetra()) AS solid;

# ST_3DTranslate shifts the bounding box by the given offsets
query IIIIII
SELECT b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z
FROM (SELECT ST_3DBounds(ST_3DTranslate(solid, 10.0, 20.0, 30.0)) AS b FROM solids);
----
10.0	20.0	30.0	11.0	21.0	31.0

# ST_3DTranslate preserves volume (rigid motion)
query I
SELECT ST_3DVolume(ST_3DTranslate(solid, 10.0, 20.0, 30.0)) = ST_3DVolume(solid) FROM solids;
----
true

# ST_3DTranslate preserves validity (rigid motion)
query I
SELECT ST_3DIsClosed(ST_3DTranslate(solid, 5.0, -5.0, 1.5)) FROM solids;
----
true

# Translate then inverse-translate round-trips the bounds
query IIIIII
SELECT b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z
FROM (SELECT ST_3DBounds(ST_3DTranslate(ST_3DTranslate(solid, 7.0, 8.0, 9.0), -7.0, -8.0, -9.0)) AS b FROM solids);
----
0.0	0.0	0.0	1.0	1.0	1.0

# NULL propagates
query I
SELECT ST_3DTranslate(NULL::SOLID_3D, 1.0, 2.0, 3.0) IS NULL;
----
true

# ST_3DScale scales the bounding box about the origin
query IIIIII
SELECT b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z
FROM (SELECT ST_3DBounds(ST_3DScale(solid, 2.0, 3.0, 4.0)) AS b FROM solids);
----
0.0	0.0	0.0	2.0	3.0	4.0

# ST_3DScale multiplies volume by sx*sy*sz (here 2*3*4 = 24 → 1/6 * 24 = 4)
query I
SELECT ROUND(ST_3DVolume(ST_3DScale(solid, 2.0, 3.0, 4.0)), 5) FROM solids;
----
4.0

# ST_3DScale preserves validity for non-degenerate factors
query I
SELECT ST_3DIsClosed(ST_3DScale(solid, 2.0, 2.0, 2.0)) FROM solids;
----
true

# NULL propagates
query I
SELECT ST_3DScale(NULL::SOLID_3D, 1.0, 2.0, 3.0) IS NULL;
----
true

# Regression: a degenerate (zero) scale factor collapses the solid. Validation
# must be recomputed, not carried over from the cache, so the result reports as
# invalid with degenerate faces rather than falsely claiming validity.
query II
SELECT r.is_valid, r.degenerate_face_count > 0
FROM (SELECT ST_3DValidationReport(ST_3DScale(solid, 0.0, 1.0, 1.0)) AS r FROM solids);
----
false	true

# Because validation is now recomputed, the collapsed solid is correctly flagged
# as degenerate, so ST_3DVolume refuses it rather than silently returning 0 on a
# geometry that falsely claimed to be valid.
statement error
SELECT ST_3DVolume(ST_3DScale(solid, 0.0, 1.0, 1.0)) FROM solids;
----
degenerate

# A non-degenerate scale stays valid after recomputation.
query I
SELECT ST_3DValidationReport(ST_3DScale(solid, 2.0, 2.0, 2.0)).is_valid FROM solids;
----
true

# ST_3DRotateX / ST_3DRotateY / ST_3DRotateZ are rigid rotations: volume is preserved
query III
SELECT ROUND(ST_3DVolume(ST_3DRotateX(solid, radians(90))), 5),
       ROUND(ST_3DVolume(ST_3DRotateY(solid, radians(37))), 5),
       ROUND(ST_3DVolume(ST_3DRotateZ(solid, radians(90))), 5)
FROM solids;
----
0.16667	0.16667	0.16667

# ST_3DRotateZ by 90 deg maps (x,y) -> (-y,x): X extent becomes [-1, 0]
query II
SELECT ROUND(b.min_x, 5), ROUND(b.max_x, 5)
FROM (SELECT ST_3DBounds(ST_3DRotateZ(solid, radians(90))) AS b FROM solids);
----
-1.0	0.0

# Rotations preserve validity
query I
SELECT ST_3DIsClosed(ST_3DRotateX(solid, radians(45))) FROM solids;
----
true

# NULL propagates for each axis
query III
SELECT ST_3DRotateX(NULL::SOLID_3D, 1.0) IS NULL,
       ST_3DRotateY(NULL::SOLID_3D, 1.0) IS NULL,
       ST_3DRotateZ(NULL::SOLID_3D, 1.0) IS NULL;
----
true	true	true

statement ok
DROP TABLE solids;
