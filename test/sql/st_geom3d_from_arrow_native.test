# name: test/sql/st_geom3d_from_arrow_native.test
# description: ST_Geom3DFromArrowNative / ST_Geom3DTryFromArrowNative ingest a padded (surface-family) nested-List/Struct value
# group: [sql]

require three_d

# Fixture: a single triangle (MultiSurface), the same physical shape as a
# padded Solid (solid-count 1, shell-count 1) — mirrors
# test/cpp/test_arrow_native_import.cpp's basic GeomModel case.
query II
SELECT ST_GeometryType(g), ST_NumGeometries(g)
FROM (
    SELECT ST_Geom3DFromArrowNative(
        [[ [ [[0,1,2]] ] ]],
        [{'x':0.0,'y':0.0,'z':0.0}, {'x':1.0,'y':0.0,'z':0.0}, {'x':0.0,'y':1.0,'z':0.0}]
    ) AS g
) q;
----
ST_MultiPolygon	1

# Area of the single triangular face: 0.5 * |(1,0,0) x (0,1,0)| = 0.5.
query I
SELECT ST_Area(ST_Geom3DFromArrowNative(
    [[ [ [[0,1,2]] ] ]],
    [{'x':0.0,'y':0.0,'z':0.0}, {'x':1.0,'y':0.0,'z':0.0}, {'x':0.0,'y':1.0,'z':0.0}]
));
----
0.5

# NULL propagation.
query I
SELECT ST_Geom3DFromArrowNative(NULL, [{'x':0.0,'y':0.0,'z':0.0}]) IS NULL;
----
true

query I
SELECT ST_Geom3DFromArrowNative([[[[[0,1,2]]]]], NULL) IS NULL;
----
true

# ST_Geom3DTryFromArrowNative: a non-padded (real 2-shell) value returns NULL
# rather than raising (only ST_3DFromArrowNative accepts multi-shell values).
query I
SELECT ST_Geom3DTryFromArrowNative(
    [[[[ [0,1,2] ]], [[ [3,4,5] ]]]],
    [{'x':0.0,'y':0.0,'z':0.0}, {'x':1.0,'y':0.0,'z':0.0}, {'x':0.0,'y':1.0,'z':0.0},
     {'x':0.0,'y':0.0,'z':1.0}, {'x':1.0,'y':0.0,'z':1.0}, {'x':0.0,'y':1.0,'z':1.0}]
) IS NULL;
----
true

# ST_Geom3DFromArrowNative: the same non-padded case raises in non-TRY mode.
statement error
SELECT ST_Geom3DFromArrowNative(
    [[[[ [0,1,2] ]], [[ [3,4,5] ]]]],
    [{'x':0.0,'y':0.0,'z':0.0}, {'x':1.0,'y':0.0,'z':0.0}, {'x':0.0,'y':1.0,'z':0.0},
     {'x':0.0,'y':0.0,'z':1.0}, {'x':1.0,'y':0.0,'z':1.0}, {'x':0.0,'y':1.0,'z':1.0}]
);
----
padding
