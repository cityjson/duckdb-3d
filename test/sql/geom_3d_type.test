# name: test/sql/geom_3d_type.test
# description: GEOM_3D general geometry type registration and construction
# group: [sql]

require three_d

# The GEOM_3D type is registered and usable in casts
query I
SELECT NULL::GEOM_3D IS NULL;
----
true

# ST_Geom3DFromWKB imports a Point Z; ST_3DGeometryType identifies the class
query I
SELECT ST_3DGeometryType(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0)));
----
ST_Point

# NULL propagation through the constructor and accessor
query I
SELECT ST_3DGeometryType(ST_Geom3DFromWKB(NULL)) IS NULL;
----
true
