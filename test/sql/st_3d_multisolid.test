# name: test/sql/st_3d_multisolid.test
# description: multi-solid (collection of solids) coverage, ungated by cityjson
# group: [sql]

require three_d

require-env THREE_D_TEST_FIXTURES

# Fixture (ST_AsWKBMultiCube): two disjoint outward cubes [0,2]^3 and [5,7]^3, each
# volume 8, surface area 24, as a GeometryCollection Z of two PolyhedralSurface Z.
# The plain-WKB path imports them as two single-shell solids. Per DESIGN_DOC §8.2
# multi-solid volume/area sum member contributions.

# Two solids, total volume 8 + 8 = 16.
query II
SELECT ST_3DNumSolids(s), ST_3DVolume(s)
FROM (SELECT ST_3DFromWKB(ST_AsWKBMultiCube()) AS s) q;
----
2	16.0

# Total surface area 24 + 24 = 48; the collection is closed.
query II
SELECT ST_3DSurfaceArea(s), ST_3DIsClosed(s)
FROM (SELECT ST_3DFromWKB(ST_AsWKBMultiCube()) AS s) q;
----
48.0	true

# Bounds span both members: [0,7] in X, [0,7] in Y/Z.
query III
SELECT (ST_3DBounds(s)).min_x, (ST_3DBounds(s)).max_x, (ST_3DBounds(s)).max_z
FROM (SELECT ST_3DFromWKB(ST_AsWKBMultiCube()) AS s) q;
----
0.0	7.0	7.0

# Metadata-aware import of a MultiSolid is now supported: the spec §8 nested
# `shells` maps one per-shell-count array to each solid (G2). Here two solids of
# one shell each ([[6],[6]]) — two solids, total volume 16.
query II
SELECT ST_3DNumSolids(s), ST_3DVolume(s)
FROM (SELECT ST_3DFromWKB(ST_AsWKBMultiCube(), '{"type": "MultiSolid", "shells": [[6], [6]]}') AS s) q;
----
2	16.0

# A shells array count that disagrees with the WKB member count is rejected.
statement error
SELECT ST_3DFromWKB(ST_AsWKBMultiCube(), '{"type": "MultiSolid", "shells": [[6]]}');
----
solid count

# ── Volume conditioning when the parts are spatially separated ────────────────
#
# ST_AsWKBMultiCube(sep) puts the second cube at [sep, sep+2]^3, so the two parts
# are `sep` apart on every axis. Total volume is 16 at every separation — volume
# is translation-invariant — but the divergence-theorem sum only holds that in
# doubles if each shell is integrated about a reference point ON that shell.
# A single model-wide reference point sits mid-way between the parts, i.e. far
# from BOTH, and the |p|^3-versus-|extent|^3 cancellation returns. Measured on
# the pre-fix build, this query returned 16.0000009 at 1e4, 16.0027 at 1e5,
# 14.456 at 1e6 (9.6% low), 2353.1 at 1e7 and 387140.3 at 1e8 — with
# ST_3DValidationReport(...).is_valid still true at every one of them: a wrong
# number and no error. See DESIGN_DOC §8.2 and the C++ pin in
# test/cpp/test_measurements.cpp.
#
# The rotation matters: an axis-aligned separation cancels exactly by luck
# (integer-representable intermediates), so only oblique faces expose it.
#
# Tolerances are measured, not guessed. What is left is the floor imposed by
# rotating absolute coordinates — the rotated vertices themselves carry |p|·eps
# rounding before ComputeVolume ever runs — which grows with the separation:
# 2.7e-12 at 1e4, 4.5e-11 at 1e5, 4.8e-10 at 1e6, 6.1e-9 at 1e7.
query IIII
SELECT abs(ST_3DVolume(ST_3DRotateX(ST_3DFromWKB(ST_AsWKBMultiCube(1e4::DOUBLE)), 0.7)) - 16.0) < 1e-10,
       abs(ST_3DVolume(ST_3DRotateX(ST_3DFromWKB(ST_AsWKBMultiCube(1e5::DOUBLE)), 0.7)) - 16.0) < 1e-9,
       abs(ST_3DVolume(ST_3DRotateX(ST_3DFromWKB(ST_AsWKBMultiCube(1e6::DOUBLE)), 0.7)) - 16.0) < 1e-8,
       abs(ST_3DVolume(ST_3DRotateX(ST_3DFromWKB(ST_AsWKBMultiCube(1e7::DOUBLE)), 0.7)) - 16.0) < 1e-7;
----
true	true	true	true

# Unrotated, the separated pair is exact, and the solid count is unchanged.
query II
SELECT ST_3DNumSolids(s), ST_3DVolume(s)
FROM (SELECT ST_3DFromWKB(ST_AsWKBMultiCube(1e6::DOUBLE)) AS s) q;
----
2	16.0
