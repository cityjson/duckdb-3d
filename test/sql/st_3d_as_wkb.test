# name: test/sql/st_3d_as_wkb.test
# description: test ST_3DAsWKB export function
# group: [sql]

require three_d

# Test: round-trip - import and export should produce valid WKB
query I
SELECT ST_3DAsWKB(ST_3DFromWKB(ST_AsWKBPolyhedralTetra())) IS NOT NULL;
----
true

# Test: re-import the exported WKB should succeed
query I
SELECT ST_3DFromWKB(ST_3DAsWKB(ST_3DFromWKB(ST_AsWKBPolyhedralTetra()))) IS NOT NULL;
----
true

# Test: NULL input returns NULL. ST_3DAsWKB is overloaded over SOLID_3D / BLOB,
# so an untyped NULL is ambiguous and must be cast (like ST_3DZMin/ST_3DZMax).
query I
SELECT ST_3DAsWKB(NULL::SOLID_3D) IS NULL;
----
true
