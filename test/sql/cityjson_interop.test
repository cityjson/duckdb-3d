# name: test/sql/cityjson_interop.test
# description: smoke test composing duckdb-cityjson with three_d (design doc §7)
# group: [sql]

# This test exercises the design-doc §7 composition: read CityJSON via the
# `cityjson` extension, then run `ST_3D*` over the resulting
# (geometry_lod<X>, geometry_properties_lod<X>) pair.
#
# `require cityjson` makes the sqllogic-test runner skip this test when
# cityjson isn't staged for the runner. It must be a build of the sibling
# duckdb-cityjson checkout — the published community extension still emits the
# pre-per-LoD `geometry` / `geometry_properties` columns and will not bind here.
# `make test_full` stages the local build; to run it by hand:
#
#   ./build/debug/duckdb -unsigned -c \
#     "LOAD '../duckdb-cityjson/build/release/extension/cityjson/cityjson.duckdb_extension'; \
#      LOAD three_d; <queries from this test>"
#
# See docs/CITYJSON_INTEROP.md.
require cityjson

require three_d

# ──────────────────────────────────────────────────────────────
# Pipe a CityJSON Solid through three_d and check core operations.
# Fixture: a unit cube authored at LoD 2.2.
# ──────────────────────────────────────────────────────────────

statement ok
CREATE TABLE buildings AS
SELECT id,
       ST_3DFromWKB(geometry_lod2_2, geometry_properties_lod2_2) AS solid
FROM read_cityjson('test/data/unit_cube.city.json', lod => '2.2')
WHERE geometry_lod2_2 IS NOT NULL;

# The column contract this composition depends on: cityjson emits one BLOB and
# one STRUCT sidecar per LoD present, named with the *normalised* LoD, and
# ST_3DFromWKB's STRUCT overload consumes the sidecar directly.
query II
SELECT column_name, column_type
FROM (DESCRIBE SELECT * FROM read_cityjson('test/data/unit_cube.city.json', lod => '2.2'))
WHERE column_name LIKE 'geometry%' ORDER BY column_name;
----
geometry_lod2_2	BLOB
geometry_properties_lod2_2	STRUCT("type" VARCHAR, surfaces VARCHAR, face_semantics INTEGER[], shells INTEGER[][])

# We get exactly one Building back, with a non-null SOLID_3D payload.
query II
SELECT id, solid IS NOT NULL FROM buildings;
----
cube	true

# Topology is what we expect for a closed unit cube.
query IIII
SELECT
    ST_3DNumSolids(solid),
    ST_3DNumShells(solid),
    ST_3DNumFaces(solid),
    ST_3DIsClosed(solid)
FROM buildings;
----
1	1	6	true

# Bounds reflect the post-transform real-world extent (1m × 1m × 1m).
query IIIIII
SELECT b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z
FROM (SELECT ST_3DBounds(solid) AS b FROM buildings);
----
0.0	0.0	0.0	1.0	1.0	1.0

# Surface area = 6 * 1m² = 6.0.
query I
SELECT ROUND(ST_3DSurfaceArea(solid), 6) FROM buildings;
----
6.0

# Volume = 1m³.
query I
SELECT ROUND(ST_3DVolume(solid), 6) FROM buildings;
----
1.0

# Validation report end-to-end.
query IIII
SELECT r.is_valid, r.is_closed, r.is_manifold, r.is_oriented
FROM (SELECT ST_3DValidationReport(solid) AS r FROM buildings);
----
true	true	true	true

statement ok
DROP TABLE buildings;
