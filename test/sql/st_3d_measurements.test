# name: test/sql/st_3d_measurements.test
# description: test ST_3DSurfaceArea and ST_3DVolume
# group: [sql]

require three_d

# Create a tetrahedron solid
statement ok
CREATE TABLE solids AS
SELECT ST_3DFromWKB(ST_AsWKBPolyhedralTetra()) AS solid;

# Test: ST_3DSurfaceArea returns a positive number
query I
SELECT ST_3DSurfaceArea(solid) > 0 FROM solids;
----
true

# Test: ST_3DVolume returns approximately 1/6 for the standard tetrahedron
# Vertices: (0,0,0), (1,0,0), (0,1,0), (0,0,1)
# Volume = |det| / 6 = 1/6 ≈ 0.16667
query I
SELECT ROUND(ST_3DVolume(solid), 5) FROM solids;
----
0.16667

# Test: ST_Area returns the XY footprint area.
# For the tetrahedron the footprint is the base triangle (0,0),(0,1),(1,0) = 0.5
query I
SELECT ROUND(ST_Area(solid), 5) FROM solids;
----
0.5

# Test: ST_3DArea is the 3D surface area (alias-aligned with ST_3DSurfaceArea)
query I
SELECT ST_3DArea(solid) = ST_3DSurfaceArea(solid) FROM solids;
----
true

# Test: NULL propagation
query III
SELECT ST_3DSurfaceArea(NULL), ST_3DVolume(NULL), ST_Area(NULL);
----
NULL	NULL	NULL

statement ok
DROP TABLE solids;

# ──────────────────────────────────────────────────────────────
# Precondition tests: ST_3DVolume must raise on invalid topology
# ──────────────────────────────────────────────────────────────

# An open shell (tetrahedron missing one face) imports successfully but
# is_closed = false → ST_3DVolume must raise per design doc §5.3.1.
statement ok
CREATE TABLE open_solid AS
SELECT ST_3DFromWKB(ST_AsWKBOpenTetra()) AS solid;

# Sanity: the shell is detected as not closed
query I
SELECT ST_3DIsClosed(solid) FROM open_solid;
----
false

# ST_3DVolume raises with the documented message
statement error
SELECT ST_3DVolume(solid) FROM open_solid;
----
not closed

# ST_3DSurfaceArea still works on an open surface (no closedness requirement)
query I
SELECT ST_3DSurfaceArea(solid) > 0 FROM open_solid;
----
true

statement ok
DROP TABLE open_solid;
