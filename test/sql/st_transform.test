# name: test/sql/st_transform.test
# description: ST_3DTransform — 2D CRS reprojection (X/Y only, Z preserved)
# group: [sql]

require three_d

require-env THREE_D_TEST_FIXTURES

# String form: reproject a Point Z from EPSG:4326 to EPSG:3857.
# Axis order is normalised, so input is (lon, lat); Z passes through unchanged.
query III
SELECT ROUND(ST_3DX(t), 1), ROUND(ST_3DY(t), 1), ST_3DZ(t)
FROM (SELECT ST_3DTransform(ST_Geom3DFromWKB(ST_AsWKBPointZ(8.0, 0.0, 5.0)), 'EPSG:4326', 'EPSG:3857') AS t) q;
----
890555.9	0.0	5.0

# Integer (EPSG) form produces the same result as the string form.
query III
SELECT ROUND(ST_3DX(t), 1), ROUND(ST_3DY(t), 1), ST_3DZ(t)
FROM (SELECT ST_3DTransform(ST_Geom3DFromWKB(ST_AsWKBPointZ(8.0, 0.0, 5.0)), 4326, 3857) AS t) q;
----
890555.9	0.0	5.0

# Round-trip 4326 -> 3857 -> 4326 recovers the original coordinates.
query III
SELECT ROUND(ST_3DX(t), 6), ROUND(ST_3DY(t), 6), ST_3DZ(t)
FROM (
    SELECT ST_3DTransform(
               ST_3DTransform(ST_Geom3DFromWKB(ST_AsWKBPointZ(4.36, 52.0, 7.5)), 4326, 3857),
               3857, 4326) AS t
) q;
----
4.36	52.0	7.5

# NULL geometry propagates.
query I
SELECT ST_3DTransform(NULL::GEOM_3D, 4326, 3857) IS NULL;
----
true

# NULL CRS argument propagates.
query I
SELECT ST_3DTransform(ST_Geom3DFromWKB(ST_AsWKBPointZ(8.0, 0.0, 5.0)), 4326, NULL::INTEGER) IS NULL;
----
true

# SOLID_3D input returns a SOLID_3D: topology is preserved (still closed, one
# solid) and Z is unchanged (min/max Z equal the original's).
query III
SELECT ST_3DNumSolids(t), ST_3DIsClosed(t), (ST_3DZMin(t) = ST_3DZMin(s) AND ST_3DZMax(t) = ST_3DZMax(s))
FROM (
    SELECT ST_3DTransform(s, 28992, 3857) AS t, s
    FROM (SELECT ST_3DFromWKB(ST_AsWKBPolyhedralTetra()) AS s) src
) q;
----
1	true	true

# An unknown SRID raises rather than silently returning a wrong result.
statement error
SELECT ST_3DTransform(ST_Geom3DFromWKB(ST_AsWKBPointZ(8.0, 0.0, 5.0)), 4326, 99999999);
----
