# name: test/sql/geom_3d_transforms.test
# description: GEOM_3D transform functions (ST_3DTranslate)
# group: [sql]

require three_d

require-env THREE_D_TEST_FIXTURES

# ST_3DTranslate shifts a Point Z by (dx, dy, dz)
query III
SELECT ST_3DX(t), ST_3DY(t), ST_3DZ(t)
FROM (SELECT ST_3DTranslate(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0)), 10.0, 20.0, 30.0) AS t) q;
----
11.0	22.0	33.0

# ST_3DTranslate shifts the bounding box of a LineString Z
query II
SELECT ST_3DZMin(t), ST_3DZMax(t)
FROM (SELECT ST_3DTranslate(ST_Geom3DFromWKB(ST_AsWKBLineZ()), 0.0, 0.0, 5.0) AS t) q;
----
5.0	17.0

# ST_3DTranslate: NULL propagates
query I
SELECT ST_3DTranslate(NULL::GEOM_3D, 1.0, 2.0, 3.0) IS NULL;
----
true

# ST_3DScale scales a Point Z about the origin
query III
SELECT ST_3DX(s), ST_3DY(s), ST_3DZ(s)
FROM (SELECT ST_3DScale(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0)), 10.0, 20.0, 30.0) AS s) q;
----
10.0	40.0	90.0

# ST_3DScale scales the bounding box of a LineString Z
query II
SELECT ST_3DZMin(s), ST_3DZMax(s)
FROM (SELECT ST_3DScale(ST_Geom3DFromWKB(ST_AsWKBLineZ()), 1.0, 1.0, 2.0) AS s) q;
----
0.0	24.0

# ST_3DScale: NULL propagates
query I
SELECT ST_3DScale(NULL::GEOM_3D, 1.0, 2.0, 3.0) IS NULL;
----
true

# ST_3DRotateZ rotates (1,0,0) by 90 deg to (0,1,0)
query III
SELECT ROUND(ST_3DX(r), 5), ROUND(ST_3DY(r), 5), ROUND(ST_3DZ(r), 5)
FROM (SELECT ST_3DRotateZ(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 0.0, 0.0)), radians(90)) AS r) q;
----
0.0	1.0	0.0

# ST_3DRotateX rotates (0,1,0) by 90 deg to (0,0,1)
query III
SELECT ROUND(ST_3DX(r), 5), ROUND(ST_3DY(r), 5), ROUND(ST_3DZ(r), 5)
FROM (SELECT ST_3DRotateX(ST_Geom3DFromWKB(ST_AsWKBPointZ(0.0, 1.0, 0.0)), radians(90)) AS r) q;
----
0.0	0.0	1.0

# ST_3DRotateY rotates (1,0,0) by 90 deg to (0,0,-1)
query III
SELECT ROUND(ST_3DX(r), 5), ROUND(ST_3DY(r), 5), ROUND(ST_3DZ(r), 5)
FROM (SELECT ST_3DRotateY(ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 0.0, 0.0)), radians(90)) AS r) q;
----
0.0	0.0	-1.0

# ST_3DRotateZ: NULL propagates
query III
SELECT ST_3DRotateX(NULL::GEOM_3D, 1.0) IS NULL,
       ST_3DRotateY(NULL::GEOM_3D, 1.0) IS NULL,
       ST_3DRotateZ(NULL::GEOM_3D, 1.0) IS NULL;
----
true	true	true
