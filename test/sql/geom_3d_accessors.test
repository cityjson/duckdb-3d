# name: test/sql/geom_3d_accessors.test
# description: GEOM_3D point accessors (ST_3DX, ST_3DY, ST_3DZ)
# group: [sql]

require three_d

require-env THREE_D_TEST_FIXTURES

statement ok
CREATE TABLE pts AS
SELECT ST_Geom3DFromWKB(ST_AsWKBPointZ(1.0, 2.0, 3.0)) AS p;

# ST_3DX / ST_3DY / ST_3DZ return the point's ordinates
query III
SELECT ST_3DX(p), ST_3DY(p), ST_3DZ(p) FROM pts;
----
1.0	2.0	3.0

# NULL propagation
query III
SELECT ST_3DX(NULL::GEOM_3D), ST_3DY(NULL::GEOM_3D), ST_3DZ(NULL::GEOM_3D);
----
NULL	NULL	NULL

# ST_CoordDim reports XYZ coordinate dimension for GEOM_3D values
query II
SELECT
    ST_CoordDim(p),
    ST_CoordDim(ST_Geom3DFromWKB(ST_AsWKBMultiLineZ()))
FROM pts;
----
3	3

# ST_CoordDim: NULL propagates
query I
SELECT ST_CoordDim(NULL::GEOM_3D);
----
NULL

# ST_3DZMin / ST_3DZMax: read the cached bounding box of a GEOM_3D value
query II
SELECT ST_3DZMin(p), ST_3DZMax(p) FROM pts;
----
3.0	3.0

# ST_3DZMin / ST_3DZMax: linestring spans Z in [0, 12]
query II
SELECT ST_3DZMin(ST_Geom3DFromWKB(ST_AsWKBLineZ())),
       ST_3DZMax(ST_Geom3DFromWKB(ST_AsWKBLineZ()));
----
0.0	12.0

# ST_3DZMin / ST_3DZMax: NULL propagates
query II
SELECT ST_3DZMin(NULL::GEOM_3D), ST_3DZMax(NULL::GEOM_3D);
----
NULL	NULL

# ST_NDims: a GEOM_3D value has coordinate dimension 3
query I
SELECT ST_NDims(p) FROM pts;
----
3

# ST_NDims: NULL propagates
query I
SELECT ST_NDims(NULL::GEOM_3D);
----
NULL

# ST_3DHasZ: a GEOM_3D value carries a Z ordinate
query I
SELECT ST_3DHasZ(p) FROM pts;
----
true

# ST_3DHasZ: NULL propagates
query I
SELECT ST_3DHasZ(NULL::GEOM_3D);
----
NULL

# ST_3DDimension: topological dimension of a Point is 0
query I
SELECT ST_3DDimension(p) FROM pts;
----
0

# ST_3DDimension: topological dimension of a LineString is 1
query I
SELECT ST_3DDimension(ST_Geom3DFromWKB(ST_AsWKBLineZ()));
----
1

# ST_3DDimension: NULL propagates
query I
SELECT ST_3DDimension(NULL::GEOM_3D);
----
NULL

# ST_3DNumGeometries: a single Point has one geometry
query I
SELECT ST_3DNumGeometries(p) FROM pts;
----
1

# ST_3DNumGeometries: a MultiLineString has two parts
query I
SELECT ST_3DNumGeometries(ST_Geom3DFromWKB(ST_AsWKBMultiLineZ()));
----
2

# ST_3DNumGeometries: NULL propagates
query I
SELECT ST_3DNumGeometries(NULL::GEOM_3D);
----
NULL

statement ok
DROP TABLE pts;
