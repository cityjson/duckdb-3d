# name: test/sql/st_3d_metadata.test
# description: test ST_3DFromWKB and ST_3DTryFromWKB with geometry_properties
# group: [sql]

require three_d

require-env THREE_D_TEST_FIXTURES

# Test: 2-arg ST_3DFromWKB with NULL metadata behaves like 1-arg
query I
SELECT ST_3DNumShells(ST_3DFromWKB(ST_AsWKBPolyhedralTetra(), NULL));
----
1

# Test: 2-arg ST_3DFromWKB with empty JSON behaves like 1-arg
query I
SELECT ST_3DNumShells(ST_3DFromWKB(ST_AsWKBPolyhedralTetra(), '{}'));
----
1

# Test: 2-arg ST_3DTryFromWKB with NULL metadata behaves like 1-arg
query I
SELECT ST_3DTryFromWKB(ST_AsWKBPolyhedralTetra(), NULL) IS NOT NULL;
----
true

# Test: 2-arg ST_3DTryFromWKB with conflicting metadata returns NULL
query I
SELECT ST_3DTryFromWKB(ST_AsWKBPolyhedralTetra(), '{"type": "Solid", "shells": [3, 3]}') IS NULL;
----
true

# Test: malformed JSON returns NULL in TRY mode
query I
SELECT ST_3DTryFromWKB(ST_AsWKBPolyhedralTetra(), '{') IS NULL;
----
true

# Test: 2-arg ST_3DFromWKB with conflicting metadata raises
statement error
SELECT ST_3DFromWKB(ST_AsWKBPolyhedralTetra(), '{"type": "Solid", "shells": [3, 3]}');
----
face count mismatch

# Test: malformed JSON raises in non-TRY mode
statement error
SELECT ST_3DFromWKB(ST_AsWKBPolyhedralTetra(), '{');
----
JSON

# Test: NULL propagation for both args
query I
SELECT ST_3DFromWKB(NULL, '{}') IS NULL;
----
true

query I
SELECT ST_3DTryFromWKB(NULL, '{}') IS NULL;
----
true

# ──────────────────────────────────────────────────────────────
# STRUCT geometry_properties overload (Task 1, arrow-native-type):
# duckdb-cityjson's arrow-native-type branch (commit d334b26) types
# geometry_properties_lod* as STRUCT("type" VARCHAR, surfaces JSON,
# face_semantics INTEGER[], shells INTEGER[][]), not VARCHAR JSON text.
# ST_3DFromWKB/ST_3DTryFromWKB must bind directly against that STRUCT
# shape without requiring an explicit to_json() cast.
# ──────────────────────────────────────────────────────────────

# Test: STRUCT overload produces the same volume as the JSON-text path,
# for the same hollow-cube fixture and shell grouping (56 = 64 - 8).
query I
SELECT ST_3DVolume(ST_3DFromWKB(ST_AsWKBHollowCube(),
    {'type': 'Solid', 'surfaces': NULL, 'face_semantics': NULL, 'shells': [[6, 6]]}));
----
56.0

# Test: STRUCT overload agrees with the equivalent to_json()-cast workaround
query I
SELECT ST_3DVolume(ST_3DFromWKB(ST_AsWKBHollowCube(),
    {'type': 'Solid', 'surfaces': NULL, 'face_semantics': NULL, 'shells': [[6, 6]]}))
    = ST_3DVolume(ST_3DFromWKB(ST_AsWKBHollowCube(), '{"type": "Solid", "shells": [6, 6]}'));
----
true

# Test: STRUCT overload with NULL metadata behaves like 1-arg
query I
SELECT ST_3DNumShells(ST_3DFromWKB(ST_AsWKBPolyhedralTetra(),
    NULL::STRUCT("type" VARCHAR, surfaces VARCHAR, face_semantics INTEGER[], shells INTEGER[][])));
----
1

# Test: STRUCT overload with conflicting shells metadata raises
statement error
SELECT ST_3DFromWKB(ST_AsWKBPolyhedralTetra(),
    {'type': 'Solid', 'surfaces': NULL, 'face_semantics': NULL, 'shells': [[3, 3]]});
----
face count mismatch

# Test: STRUCT overload with conflicting shells metadata returns NULL in TRY mode
query I
SELECT ST_3DTryFromWKB(ST_AsWKBPolyhedralTetra(),
    {'type': 'Solid', 'surfaces': NULL, 'face_semantics': NULL, 'shells': [[3, 3]]}) IS NULL;
----
true

# Test: a NULL element inside the outer shells list (one solid's per-shell
# array itself null) is rejected, not read as garbage bytes.
query I
SELECT ST_3DTryFromWKB(ST_AsWKBPolyhedralTetra(),
    {'type': 'Solid', 'surfaces': NULL, 'face_semantics': NULL, 'shells': [NULL]}) IS NULL;
----
true

statement error
SELECT ST_3DFromWKB(ST_AsWKBPolyhedralTetra(),
    {'type': 'Solid', 'surfaces': NULL, 'face_semantics': NULL, 'shells': [NULL]});
----
null

# Test: a NULL face-count element inside a per-shell array is rejected too.
query I
SELECT ST_3DTryFromWKB(ST_AsWKBPolyhedralTetra(),
    {'type': 'Solid', 'surfaces': NULL, 'face_semantics': NULL, 'shells': [[3, NULL]]}) IS NULL;
----
true

statement error
SELECT ST_3DFromWKB(ST_AsWKBPolyhedralTetra(),
    {'type': 'Solid', 'surfaces': NULL, 'face_semantics': NULL, 'shells': [[3, NULL]]});
----
null
