# name: test/sql/metamorphic_transforms.test
# description: metamorphic invariance coverage for the transform family (dependency-free)
# group: [sql]

# A dependency-free oracle for ST_3DTranslate / ST_3DRotateX/Y/Z / ST_3DScale.
# The differential harness now oracles those against PostGIS too, but only
# through derived scalars (transformed bbox, re-measured volume/area — see
# postgis_oracle.test), because round-tripping PostGIS geometry back through
# the ISO parser is forbidden. Metamorphic relations need no engine at all and,
# run over the frozen 3DBAG golden WKB, they cover REAL geometry:
#   * rigid motions (translation, rotation) preserve volume and surface area;
#   * scaling multiplies volume by |sx·sy·sz| and area (uniform) by s².
# Tolerances were measured, not guessed (see the golden section).

require three_d

require-env THREE_D_TEST_FIXTURES

# ── Controlled fixtures: exact to machine precision (small integer coords) ─────

# Unit tetrahedron, volume 1/6: invariant under translation & rotation; volume
# scales by 2·3·4 = 24 under ST_3DScale.
query I
SELECT abs(ST_3DVolume(ST_3DTranslate(t, 10, 20, 30)) - ST_3DVolume(t)) < 1e-12
   AND abs(ST_3DVolume(ST_3DRotateZ(t, 0.5)) - ST_3DVolume(t)) < 1e-12
   AND abs(ST_3DVolume(ST_3DScale(t, 2, 3, 4)) - 24 * ST_3DVolume(t)) < 1e-12
FROM (SELECT ST_3DFromWKB(ST_AsWKBPolyhedralTetra()) AS t) q;
----
true

# Hollow cube (volume 56): the interior-shell subtraction survives rigid motions,
# and scales with the solid.
query I
SELECT abs(ST_3DVolume(ST_3DTranslate(h, 5, 5, 5)) - 56.0) < 1e-9
   AND abs(ST_3DVolume(ST_3DScale(h, 2, 2, 2)) - 8 * 56.0) < 1e-9
FROM (SELECT ST_3DFromWKB(ST_AsWKBHollowCube(), '{"type": "Solid", "shells": [6, 6]}') AS h) q;
----
true

# Surface area is a rigid-motion invariant (unit tetra area = 3·0.5 + √3/2).
query I
SELECT abs(ST_3DSurfaceArea(ST_3DRotateZ(t, 1.3)) - ST_3DSurfaceArea(t)) < 1e-12
   AND abs(ST_3DSurfaceArea(ST_3DTranslate(t, 9, 9, 9)) - ST_3DSurfaceArea(t)) < 1e-12
FROM (SELECT ST_3DFromWKB(ST_AsWKBPolyhedralTetra()) AS t) q;
----
true

# ── Real 3DBAG golden solids: invariants at RD coordinate magnitudes ──────────
# Every relation below holds at the same measured 1e-5 relative tolerance, since
# ComputeVolume references its signed tetrahedra to a point ON THE SHELL being
# integrated rather than to the absolute origin (b019978, granularity corrected
# to per-shell later) — before that, translation at RD magnitudes (~1e5) drifted
# by ~3.5e-5 and the X/Y rotations by up to 12%. The measured maxima over the
# real Delft tile are now 3.0e-11 relative under rotation and exactly 0 under
# translation, so 1e-5 leaves six orders of headroom.
# Boolean predicates over the whole corpus, so a regression in any solid fails.

# Materialise the solid-role rows FIRST. golden.csv also carries GEOM_3D-class
# fixtures (points, lines, polygons) that ST_3DFromWKB rejects outright, and a
# single SELECT that both filters on geom_role and calls ST_3DFromWKB is not
# guaranteed to evaluate them in that order.
statement ok
CREATE TABLE _golden_solid_wkb AS
SELECT wkb_hex FROM read_csv('test/data/postgis_oracle/golden.csv', header = true)
WHERE geom_role = 'solid';

statement ok
CREATE TABLE _golden AS
SELECT ST_3DFromWKB(unhex(wkb_hex)) AS s
FROM _golden_solid_wkb
WHERE ST_3DIsClosed(ST_3DFromWKB(unhex(wkb_hex)))
  AND ST_3DIsManifold(ST_3DFromWKB(unhex(wkb_hex)))
  AND ST_3DIsOriented(ST_3DFromWKB(unhex(wkb_hex)));

# Non-vacuity: the corpus actually has real solids to transform.
query I
SELECT count(*) >= 10 FROM _golden;
----
true

# Rotation about Z preserves volume (relative tol 1e-5).
query I
SELECT bool_and(abs(ST_3DVolume(ST_3DRotateZ(s, 0.7)) - ST_3DVolume(s)) <= 1e-5 * ST_3DVolume(s)) FROM _golden;
----
true

# Rotation about X and Y preserves volume just as well as about Z. These are the
# axes that mix the large RD northing into Z, so before ComputeVolume referenced
# its triple products to a local point they drifted by up to 12% on this very
# corpus while RotateZ stayed clean — see docs/TESTING.md §21.
query I
SELECT bool_and(abs(ST_3DVolume(ST_3DRotateX(s, 0.7)) - ST_3DVolume(s)) <= 1e-5 * ST_3DVolume(s)) FROM _golden;
----
true

query I
SELECT bool_and(abs(ST_3DVolume(ST_3DRotateY(s, 0.7)) - ST_3DVolume(s)) <= 1e-5 * ST_3DVolume(s)) FROM _golden;
----
true

# Metamorphic scaling: volume scales by |2·3·4| = 24 (relative tol 1e-5).
query I
SELECT bool_and(abs(ST_3DVolume(ST_3DScale(s, 2, 3, 4)) - 24 * ST_3DVolume(s)) <= 1e-5 * 24 * ST_3DVolume(s)) FROM _golden;
----
true

# Translation preserves volume. This held only to 1e-3 while the tetrahedra were
# summed about the absolute origin; referencing them to the model's own bbox
# midpoint makes the sum independent of where the model sits, so it now holds at
# the same 1e-5 as every other rigid motion.
query I
SELECT bool_and(abs(ST_3DVolume(ST_3DTranslate(s, 1000, 2000, 500)) - ST_3DVolume(s)) <= 1e-5 * ST_3DVolume(s)) FROM _golden;
----
true

# Surface area is invariant under rotation (relative tol 1e-5).
query I
SELECT bool_and(abs(ST_3DSurfaceArea(ST_3DRotateZ(s, 0.7)) - ST_3DSurfaceArea(s)) <= 1e-5 * ST_3DSurfaceArea(s)) FROM _golden;
----
true

statement ok
DROP TABLE _golden;

statement ok
DROP TABLE _golden_solid_wkb;
