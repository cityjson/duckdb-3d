# name: test/sql/sqlmm_profile.test
# description: SQL/MM profile one-liners: ST_3DArea and ST_3DPerimeter on GEOM_3D, ST_3DCentroid on SOLID_3D, ST_3DIsValid, ST_3DDisjoint
# group: [sql]

require three_d

require-env THREE_D_TEST_FIXTURES

# Every expected value follows from the construction.

# ST_3DArea on a polygon leaves its hole out; ST_3DPerimeter counts every ring, as
# PostGIS's ST_3DPerimeter does.
query II
SELECT ST_3DArea(g), ST_3DPerimeter(g)
FROM (SELECT ST_Geom3DFromWKB('POLYGON Z ((0 0 0, 10 0 0, 10 10 0, 0 10 0, 0 0 0),
                                          (3 3 0, 3 7 0, 7 7 0, 7 3 0, 3 3 0))'::GEOMETRY) AS g);
----
84.0	56.0

# A tilted square: 2 along x, 2 * sqrt(2) up the slope.
query II
SELECT ROUND(ST_3DArea(g), 12) = ROUND(4 * sqrt(2), 12), ROUND(ST_3DPerimeter(g), 12) = ROUND(4 + 4 * sqrt(2), 12)
FROM (SELECT ST_Geom3DFromWKB('POLYGON Z ((0 0 0, 2 0 0, 2 2 2, 0 2 2, 0 0 0))'::GEOMETRY) AS g);
----
true	true

# A PolyhedralSurface's area sums its patches and its perimeter is its boundary,
# empty for a closed surface (PostGIS sums every ring instead); points and lines
# have neither.
query IIII
SELECT ST_3DArea(s), ST_3DPerimeter(s), ST_3DArea(l), ST_3DPerimeter(p)
FROM (SELECT ST_Geom3DFromWKB(ST_3DAsWKB(ST_3DExtrude(ST_Geom3DFromWKB(
                 'POLYGON Z ((0 0 0, 2 0 0, 2 2 0, 0 2 0, 0 0 0))'::GEOMETRY), 3.0))) AS s,
             ST_Geom3DFromWKB('LINESTRING Z (0 0 0, 1 1 1)'::GEOMETRY) AS l,
             ST_Geom3DFromWKB('POINT Z (1 2 3)'::GEOMETRY) AS p);
----
32.0	0.0	0.0	0.0

# ST_3DCentroid of a SOLID_3D is the centroid of its volume: for an L-shaped prism
# of height 2, the mean of its three unit squares' centres, half way up.
query III
SELECT ROUND(ST_3DX(c), 12), ROUND(ST_3DY(c), 12), ST_3DZ(c)
FROM (SELECT ST_3DCentroid(ST_3DExtrude(ST_Geom3DFromWKB(
          'POLYGON Z ((0 0 0, 2 0 0, 2 1 0, 1 1 0, 1 2 0, 0 2 0, 0 0 0))'::GEOMETRY), 2.0)) AS c);
----
0.833333333333	0.833333333333	1.0

# A cavity is left out: the hollow cube [0,4]^3 with the cavity [1,3]^3 off-centre
# would move the centroid, a centred one does not.
query III
SELECT ST_3DX(c), ST_3DY(c), ST_3DZ(c)
FROM (SELECT ST_3DCentroid(ST_3DFromWKB(ST_AsWKBHollowCube(), '{"type": "Solid", "shells": [[6, 6]]}')) AS c);
----
2.0	2.0	2.0

# An open solid encloses no volume.
statement error
SELECT ST_3DCentroid(ST_3DFromWKB(ST_AsWKBOpenTetra()));
----
ST_3DCentroid: solid is not closed

# ST_3DIsValid is the validation report's verdict.
query II
SELECT ST_3DIsValid(ST_3DFromWKB(ST_AsWKBHollowCube(), '{"type": "Solid", "shells": [[6, 6]]}')),
       ST_3DIsValid(ST_3DFromWKB(ST_AsWKBOpenTetra()));
----
true	false

# ST_3DDisjoint is the negation of ST_3DIntersects, solids included.
query IIII
SELECT ST_3DDisjoint(a, b), ST_3DDisjoint(a, c), ST_3DDisjoint(s, p), ST_3DDisjoint(p, s)
FROM (SELECT ST_Geom3DFromWKB('POINT Z (0 0 0)'::GEOMETRY) AS a,
             ST_Geom3DFromWKB('POINT Z (0 0 1)'::GEOMETRY) AS b,
             ST_Geom3DFromWKB('LINESTRING Z (0 0 -1, 0 0 1)'::GEOMETRY) AS c,
             ST_3DExtrude(ST_Geom3DFromWKB('POLYGON Z ((0 0 0, 4 0 0, 4 4 0, 0 4 0, 0 0 0))'::GEOMETRY), 4.0) AS s,
             ST_Geom3DFromWKB('POINT Z (2 2 2)'::GEOMETRY) AS p);
----
true	false	false	false

query II
SELECT ST_3DDisjoint(s, t), ST_3DDisjoint(s, ST_3DTranslate(t, 10, 0, 0))
FROM (SELECT ST_3DExtrude(ST_Geom3DFromWKB('POLYGON Z ((0 0 0, 4 0 0, 4 4 0, 0 4 0, 0 0 0))'::GEOMETRY), 4.0) AS s,
             ST_3DExtrude(ST_Geom3DFromWKB('POLYGON Z ((1 1 1, 2 1 1, 2 2 1, 1 2 1, 1 1 1))'::GEOMETRY), 1.0) AS t);
----
false	true

# An open box, its top missing: the boundary is the top's four edges. (The WKB is
# PostGIS's ST_AsBinary of the five faces; DuckDB's GEOMETRY has no polyhedral
# surface literal.)
query I
SELECT ST_3DPerimeter(ST_Geom3DFromWKB(from_hex('')));
----
8.0
