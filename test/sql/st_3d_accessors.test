# name: test/sql/st_3d_accessors.test
# description: test ST_3D accessor functions (NDims, HasZ, ZMin, ZMax)
# group: [sql]

require three_d

statement ok
CREATE TABLE solids AS
SELECT ST_3DFromWKB(ST_AsWKBPolyhedralTetra()) AS solid;

# ST_NDims: a 3D solid has coordinate dimension 3
query I
SELECT ST_NDims(solid) FROM solids;
----
3

# ST_NDims: NULL propagates
query I
SELECT ST_NDims(NULL::SOLID_3D);
----
NULL

# ST_3DHasZ: a 3D solid carries a Z ordinate
query I
SELECT ST_3DHasZ(solid) FROM solids;
----
true

# ST_3DHasZ: NULL propagates
query I
SELECT ST_3DHasZ(NULL::SOLID_3D);
----
NULL

# ST_3DZMin / ST_3DZMax: tetrahedron spans Z in [0, 1]
query II
SELECT ST_3DZMin(solid), ST_3DZMax(solid) FROM solids;
----
0.0	1.0

# ST_3DZMax - ST_3DZMin is the building height
query I
SELECT ST_3DZMax(solid) - ST_3DZMin(solid) FROM solids;
----
1.0

# ST_3DZMin / ST_3DZMax: NULL propagates
query II
SELECT ST_3DZMin(NULL::SOLID_3D), ST_3DZMax(NULL::SOLID_3D);
----
NULL	NULL

statement ok
DROP TABLE solids;
