# name: test/sql/spatial_join.test
# description: ST_3DEnvelope gives spatial's spatial join its candidates; ST_3DDWithin refines them
# group: [sql]

require three_d

require spatial

# Ten boxes along x, 1 m wide with 1.5 m gaps, alternately at z 0 and z 100.
statement ok
CREATE TABLE s AS SELECT i, ST_3DExtrude(ST_3DGeomFromText(
    'POLYGON Z ((' || 2.5 * i || ' 0 ' || 100 * (i % 2) || ', ' || 2.5 * i + 1 || ' 0 ' || 100 * (i % 2) || ', '
    || 2.5 * i + 1 || ' 1 ' || 100 * (i % 2) || ', ' || 2.5 * i || ' 1 ' || 100 * (i % 2) || ', '
    || 2.5 * i || ' 0 ' || 100 * (i % 2) || '))'), 3.0) AS solid
FROM range(10) t(i);

# The envelopes' 2D distance never exceeds the solids' 3D distance, so the join
# on the envelopes keeps every pair the 3D test needs: here the neighbours in x
# (1.5 m and 4 m apart in 2D; three apart is 6.5 m), of which only the pairs two
# apart share a z level. A threshold of 4.5 keeps the 4 m pairs off the boundary.
# The join condition is the envelope predicate alone: DuckDB folds any other
# comparison of the two sides, such as a.i < b.i, into the join and plans a
# merge or nested-loop join instead, so that one goes inside the refinement.
query II
EXPLAIN SELECT count(*) FROM s a JOIN s b ON ST_DWithin(ST_3DEnvelope(a.solid), ST_3DEnvelope(b.solid), 4.5)
WHERE CASE WHEN a.i < b.i THEN ST_3DDWithin(a.solid, b.solid, 4.5) ELSE false END;
----
physical_plan	<REGEX>:.*Spatial Join.*

query II
SELECT count(*), list(a.i || '-' || b.i ORDER BY a.i, b.i) FROM s a JOIN s b
    ON ST_DWithin(ST_3DEnvelope(a.solid), ST_3DEnvelope(b.solid), 4.5)
WHERE CASE WHEN a.i < b.i THEN ST_3DDWithin(a.solid, b.solid, 4.5) ELSE false END;
----
8	[0-2, 1-3, 2-4, 3-5, 4-6, 5-7, 6-8, 7-9]

# The same pairs as the nested loop over every pair.
query I
SELECT count(*) FROM s a, s b WHERE a.i < b.i AND ST_3DDWithin(a.solid, b.solid, 4.5);
----
8
